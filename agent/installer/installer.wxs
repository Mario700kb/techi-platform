<?xml version="1.0" encoding="UTF-8"?>
<!--
  TECHI Agent - WiX 7 MSI Installer
  UpgradeCode: E6AD0A88-5F26-5665-9B1F-70B8C5EE8363 (mos ndrysho kurrë, duhet
  te perputhet me prodhimin per te aktivizuar MajorUpgrade)
  Version vjen nga agent/VERSION, jo hardcoded; shih build.sh / CI workflow.
  Build:   wix build installer.wxs -arch x64 -ext WixToolset.UI.wixext -d SourceDir=. -d Version=2.1.0.0 -o TECHI-Endpoint-Deployment-2.1.0.msi
  GPO:     msiexec /i TECHI-Endpoint-Deployment-2.1.0.msi /qn ENROLLMENT_TOKEN="xxx"
  Manual:  double-click MSI → dialog kërkon token → Install
-->
<?ifndef Version?>
<?define Version="0.0.0.0"?>
<?endif?>
<?ifndef BuildCommit?>
<?define BuildCommit="dev"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="TECHI Agent"
           Version="$(var.Version)"
           Manufacturer="TECHI Solutions SH.P.K."
           UpgradeCode="E6AD0A88-5F26-5665-9B1F-70B8C5EE8363"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of TECHI Agent is already installed."
                  Schedule="afterInstallInitialize"/>
    <MediaTemplate EmbedCab="yes"/>

    <Property Id="ARPCOMMENTS" Value="TECHI Platform endpoint management"/>
    <Icon Id="TechiIcon" SourceFile="..\TECHI-branding-assets\techi-icon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="TechiIcon"/>
    <Binary Id="TechiIconBin" SourceFile="..\TECHI-branding-assets\techi-icon.ico"/>
    <Binary Id="BannerBmp" SourceFile="banner.bmp"/>
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="banner.bmp"/>
    <Property Id="ENROLLMENT_TOKEN" Secure="yes"/>
    <Property Id="API_URL" Value="https://api-rdp.techi.com.al" Secure="yes"/>
    <!-- UI_REENROLL: vendoset vetëm kur Install klikohet te EnrollmentTokenDlg (instalim manual).
         Lejon WriteAgentConfig të mbishkruajë config-un ekzistues me token-in e ri, edhe nëse
         file-i tashmë ekziston nga teste/instalime të mëparshme. Rruga /quiet (GPO/self_update)
         kurrë nuk e vendos këtë property, kështu që mbrojtja e device_id gjatë upgrade në fushë
         mbetet e paprekur. -->
    <Property Id="UI_REENROLL" Secure="yes"/>

    <!-- Kontrollon nëse TECHI Remote Support.exe ekziston tashmë -->
    <Property Id="TECHI_RS_EXE">
      <DirectorySearch Id="SearchTechiRS"
                       Path="[ProgramFiles6432Folder]TECHI Remote Support">
        <FileSearch Name="TECHI Remote Support.exe"/>
      </DirectorySearch>
    </Property>

    <!-- Konfigurim i TECHI Remote Support (RustDesk) — identik me v1.0.4 -->
    <Property Id="REMOTE_SERVER"   Value="139.162.158.208"/>
    <Property Id="REMOTE_RELAY"    Value="139.162.158.208"/>
    <Property Id="REMOTE_KEY"      Value="8B5Z8Vp6ZKVUYOQsLxL+rktKft7s4KyozByrIPG8qSw=" Secure="yes"/>
    <Property Id="REMOTE_PASSWORD" Value="Durres.12" Secure="yes"/>
    <Property Id="LEGACY_TECHI_ENDPOINT_104_A" Value="{134568B7-BCB0-4341-933B-C24DA78DEF6E}"/>
    <Property Id="LEGACY_TECHI_ENDPOINT_104_B" Value="{110919C6-BCB0-4341-933B-C24DA78DEF6E}"/>
    <Property Id="LEGACY_TECHI_ENDPOINT_104_C" Value="{3154867B-CB0B-3414-39B3-2CD47AD8FEE6}"/>

    <!-- Abort (Type 19): ndal instalimet pa token — për /qn pa dialog -->
    <CustomAction Id="AbortNoToken"
                  Error="Enrollment token is required.&#13;&#10;GPO: msiexec /i TECHI-Endpoint-Deployment-2.1.0.msi /qn ENROLLMENT_TOKEN=your_token"/>

    <!-- WixUI_Common: Progress, Exit, Cancel, FatalError dialogs — pa Welcome/License/Features wizard -->
    <ui:WixUI Id="WixUI_Common"/>

    <!-- Dialog i vetëm (stil v2.0.0, jo wizard multi-hap):
         Fresh install:  EnrollmentTokenDlg → ProgressDlg → ExitDlg
         Upgrade:        EnrollmentTokenDlg skip-ohet (Condition="NOT Installed")
         /quiet me token: AbortNoToken nuk aktivizohet, instalohet pa UI
         /quiet pa token: AbortNoToken exit 1603 -->
    <UI>
      <!-- EnrollmentTokenDlg: dialog i vetëm — icon TECHI lart majtas + titull + nëntitull + 1 fushë token -->
      <Dialog Id="EnrollmentTokenDlg" Width="370" Height="185" Title="[ProductName] — Setup">
        <Control Id="DialogIcon" Type="Icon" X="15" Y="8" Width="32" Height="32"
                 ToolTip="TECHI" FixedSize="yes" IconSize="32" Text="TechiIconBin"/>

        <Control Id="Title" Type="Text" X="50" Y="10" Width="300" Height="15"
                 Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}TECHI Agent — Enrollment"/>
        </Control>
        <Control Id="Subtitle" Type="Text" X="50" Y="26" Width="300" Height="18"
                 Transparent="yes" NoPrefix="yes">
          <Text Value="Enter the enrollment token to register this device with TECHI platform."/>
        </Control>

        <Control Id="Sep1" Type="Line" X="0" Y="48" Width="370" Height="0"/>

        <Control Id="TokenLabel" Type="Text" X="20" Y="58" Width="330" Height="12"
                 NoPrefix="yes">
          <Text Value="&amp;Enrollment Token:"/>
        </Control>
        <Control Id="TokenEdit" Type="Edit" X="20" Y="73" Width="330" Height="20"
                 Property="ENROLLMENT_TOKEN" Text="{256}" TabSkip="no"/>

        <Control Id="Sep2" Type="Line" X="0" Y="149" Width="370" Height="0"/>

        <Control Id="Install" Type="PushButton" X="178" Y="158" Width="80" Height="17"
                 Default="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return"
                   Condition="ENROLLMENT_TOKEN &lt;&gt; &quot;&quot;"/>
          <Publish Property="UI_REENROLL" Value="1"
                   Condition="ENROLLMENT_TOKEN &lt;&gt; &quot;&quot;"/>
          <Publish Event="SpawnDialog" Value="TokenRequiredDlg"
                   Condition="ENROLLMENT_TOKEN = &quot;&quot;"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="270" Y="158" Width="80" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1"/>
        </Control>
      </Dialog>

      <!-- TokenRequiredDlg: modal error kur token mungon -->
      <Dialog Id="TokenRequiredDlg" Width="260" Height="85" Title="TECHI Agent" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="40" NoPrefix="yes">
          <Text Value="Enrollment token is required.&#13;&#10;&#13;&#10;Please enter the token before continuing."/>
        </Control>
        <Control Id="OK" Type="PushButton" X="102" Y="58" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" Condition="1"/>
        </Control>
      </Dialog>

      <!-- Shfaq token dialog gjithmonë gjatë instalimit manual (double-click), pavarësisht
           nëse është fresh install ose upgrade — vetëm /quiet (GPO) e kapërcen UI fare.
           AbortNoToken (InstallExecuteSequence) mbetet i paprekur dhe vazhdon të mbrojë
           rrugën /quiet pa token. -->
      <InstallUISequence>
        <Show Dialog="EnrollmentTokenDlg" Before="ExecuteAction" Condition="1"/>
      </InstallUISequence>
    </UI>

    <!-- ===== DIREKTORITË ===== -->
    <!-- INSTALLFOLDER  = C:\ProgramData\TechiAgent\  (CommonAppDataFolder → "CommApp" në admin extract)
         TECHIDATADIR   = C:\ProgramData\TECHI\        (konfig + logs)
         Te dyja jane nen CommonAppDataFolder — MOS e ndrysho parent te StandardDirectory:
           ndryshimi do te thyente admin-install path (msiexec /a) qe techi-deploy.cmd :manual_replace_lan
           pret per agent-in (jo per Remote Support, shih me poshte).
         ADMIN INSTALL PATH I GARANTUAR (msiexec /a):
           [TARGETDIR]\CommApp\TechiAgent\techi-agent.exe  ← ky path DUHET hardcoded në techi-deploy.cmd -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="TechiAgent"/>
      <Directory Id="TECHIDATADIR" Name="TECHI"/>
    </StandardDirectory>
    <!-- REMOTESUPPORTFOLDER = C:\Program Files\TECHI Remote Support\ ; Program Files, jo ProgramData.
         Perputhet me installer-in real te references (TECHI-Remote-Support.iss, Inno Setup, v1.4.6)
         dhe me flotat e instaluara me te.
         Service + Tray (jo vetem Tray): agent/rustdesk_manage.go krijon/mban Windows Service-in
         "TECHI Remote Support" (argumenti service) ne runtime — ky eshte daemon-i real qe pranon
         lidhje hyrese. Nje teori e mehershme ne kete kod thoshte se SCM/Session 0 nuk mund te beje
         screen-capture interaktiv, prandaj u hoq service-i ne favor te vetem nje Scheduled Task
         (rustdeskTrayTaskName me poshte) qe nis RS me argumentin tray ne sesionin e perdoruesit —
         por RustDesk vete e perdor argumentin service pikerisht keshtu (burimi: src/platform/
         windows.rs get_create_service/install_service), dhe argumenti tray vetem (pa service)
         eshte nje klient UI i hollë pa daemon — shkaktonte "installed/running" ne UI por deshtim
         te cdo "connect" (konfirmuar real, metropolgroup.local/NODE04). Tani te dyja bashke:
         service eshte daemon-i, Scheduled Task + tray eshte vetem ikona shoqeruese. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="REMOTESUPPORTFOLDER" Name="TECHI Remote Support"/>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="TechiMenuFolder" Name="TECHI"/>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder"/>
    <!-- ===== FEATURES ===== -->
    <Feature Id="ProductFeature" Title="TECHI Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
      <ComponentGroupRef Id="RemoteSupportComponents"/>
      <ComponentRef Id="StartMenuShortcuts"/>
      <ComponentRef Id="PublicDesktopShortcut"/>
    </Feature>

    <!-- ===== KOMPONENTËT ===== -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- techi-agent.exe + Windows Service -->
      <Component Id="AgentExe" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="TechiAgentExe"
              Source="$(var.SourceDir)\techi-agent.exe"
              Name="techi-agent.exe"
              KeyPath="yes"/>
        <ServiceInstall Id="TechiAgentService"
                        Name="TechiAgent"
                        DisplayName="TECHI Agent"
                        Description="TECHI Platform endpoint monitoring and management agent"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="ignore"
                        Account="LocalSystem"/>
        <ServiceControl Id="StartTechiAgent"
                        Name="TechiAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes"/>
      </Component>

      <!-- C:\ProgramData\TECHI\ — direktoria e të dhënave -->
      <Component Id="AgentDataDir" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891"
                 Directory="TECHIDATADIR">
        <CreateFolder/>
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\TECHI\Agent"
                       Name="DataDir"
                       Type="string"
                       Value="[TECHIDATADIR]"
                       KeyPath="yes"/>
        <!-- BuildCommit: git short SHA i ketij build-i (nga CI -d BuildCommit=...), jo ProductVersion
             (ai mbetet 2.1.0). Lejon te verifikohet ne PC pikerisht cili kod eshte instaluar, pa pyetur
             "cilin build prove"; reg query HKLM\SOFTWARE\TECHI\Agent /v BuildCommit -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\TECHI\Agent"
                       Name="BuildCommit"
                       Type="string"
                       Value="$(var.BuildCommit)"/>
      </Component>

      <!-- techiremotesupport:// protocol handler -->
      <Component Id="ProtocolReg" Guid="D4E5F6A7-B8C9-0123-DEF0-234567890123">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\techiremotesupport">
          <RegistryValue Type="string" Value="URL:TECHI Remote Support Protocol"
                         KeyPath="yes"/>
          <RegistryValue Name="URL Protocol" Type="string" Value=""/>
        </RegistryKey>
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\techiremotesupport\shell\open\command">
          <RegistryValue Type="string"
                         Value="&quot;[REMOTESUPPORTFOLDER]TECHI Remote Support.exe&quot; &quot;%1&quot;"/>
        </RegistryKey>
      </Component>

    </ComponentGroup>

    <!-- TECHI Remote Support binaries -->
    <ComponentGroup Id="RemoteSupportComponents" Directory="REMOTESUPPORTFOLDER">
      <Files Include="$(var.SourceDir)\TECHI-Remote-Support\**"/>
    </ComponentGroup>

    <!-- Public Desktop: TECHI Remote Support.lnk — deklarativ (me pare krijohej nga
         PS-i i WriteAgentConfig). Scope perMachine => DesktopFolder = C:\Users\Public\Desktop. -->
    <Component Id="PublicDesktopShortcut" Guid="7E2F30A1-94C3-4B7D-8F1A-6D5E42C9B310"
               Directory="DesktopFolder">
      <Shortcut Id="RemoteSupportDesktopShortcut"
                Name="TECHI Remote Support"
                Target="[REMOTESUPPORTFOLDER]TECHI Remote Support.exe"
                WorkingDirectory="REMOTESUPPORTFOLDER"
                Description="TECHI Remote Support"/>
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\TECHI\Agent"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes"/>
    </Component>

    <!-- Start Menu: Programs\TECHI\TECHI Remote Support.lnk -->
    <Component Id="StartMenuShortcuts" Guid="C5D6E7F8-A9B0-1234-CDEF-123456789012"
               Directory="TechiMenuFolder">
      <Shortcut Id="RemoteSupportMenuShortcut"
                Name="TECHI Remote Support"
                Target="[REMOTESUPPORTFOLDER]TECHI Remote Support.exe"
                WorkingDirectory="REMOTESUPPORTFOLDER"
                Description="TECHI Remote Support"/>
      <RemoveFolder Id="CleanTechiMenuFolder" Directory="TechiMenuFolder" On="uninstall"/>
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\TECHI\Agent"
                     Name="StartMenuInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes"/>
      <!-- The "TECHI Remote Support" Windows Service is created at RUNTIME by
           the agent (rustdesk_manage.go: ensureRustDeskService, "sc create"),
           not declaratively by this MSI, so there's no matching ServiceInstall
           here. This ServiceControl just asks SCM to stop it cleanly on
           uninstall if it happens to exist at that point. -->
      <ServiceControl Id="StopTechiRemoteSupport"
                       Name="TECHI Remote Support"
                       Stop="uninstall"
                       Wait="no"/>
    </Component>

    <!-- ===== CUSTOM ACTIONS ===== -->

    <!-- WriteAgentConfig: krijon agent.config.json nëse nuk ekziston, OSE e mbishkruan
         nëse UI_REENROLL=1 (instalim manual me token të ri — shih Install button te
         EnrollmentTokenDlg). Rruga /quiet kurrë nuk vendos UI_REENROLL, kështu që
         device_id mbrohet gjithmonë gjatë upgrade/self_update në fushë.
         Ekzekutohet nga vetë techi-agent.exe (bootstrap-config, kod natif Go) —
         jo PowerShell: AV/AMSI strikte (Symantec, CybeeAI) bllokojnë çdo skript,
         që linte instalimet gjysmë të konfiguruara. Shortcut-i i desktop-it publik
         tani krijohet deklarativisht nga vetë MSI (PublicDesktopShortcut më poshtë). -->
    <CustomAction Id="WriteAgentConfig"
                  Directory="TECHIDATADIR"
                  ExeCommand="&quot;[INSTALLFOLDER]techi-agent.exe&quot; bootstrap-config -api-url &quot;[API_URL]&quot; -enrollment-token &quot;[ENROLLMENT_TOKEN]&quot; -reenroll &quot;[UI_REENROLL]&quot; -rustdesk-server &quot;[REMOTE_SERVER]&quot; -rustdesk-relay &quot;[REMOTE_RELAY]&quot; -rustdesk-key &quot;[REMOTE_KEY]&quot; -rustdesk-password &quot;[REMOTE_PASSWORD]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- LockdownTechiDataDir: agent.config.json ka enrollment_token, rustdesk_key, rustdesk_default_password
         në plaintext. ProgramData trashëgon ACL që lë "Users" me Read, kështu që çdo llogari lokale e PC-së
         mund ta lexonte; icacls heq trashëgimine dhe lë vetëm SYSTEM + Administrators (sipas SID, jo emrit,
         që funksionon në çdo locale Windows). /T/(OI)(CI) e zbatojnë te skedarët ekzistues dhe te ata të rinj. -->
    <CustomAction Id="LockdownTechiDataDir"
                  Directory="TECHIDATADIR"
                  ExeCommand="icacls.exe &quot;[TECHIDATADIR].&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F /T /C /Q"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- EnsureServiceCreated: rrjet sigurie kundër race-condition SCM (DeleteServices i produktit
         të vjetër + InstallServices i produktit të ri për të njëjtin emër service-i brenda së
         njëjtës transaksion MSI). Verifikon TechiAgent pas StartServices; nëse mungon dhe exe
         ekziston, e rikrijon, i vendos recovery actions dhe e nis — logjika është
         `techi-agent.exe watchdog-check` (kod natif Go, shih swap_windows.go), pa PowerShell. -->
    <CustomAction Id="EnsureServiceCreated"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[INSTALLFOLDER]techi-agent.exe&quot; watchdog-check"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- SetServiceRecovery: restart automatik pas dështimit (sc.exe direkt, pa PS wrapper) -->
    <CustomAction Id="SetServiceRecovery"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe failure TechiAgent reset= 86400 actions= restart/60000/restart/60000/restart/300000"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- SHENIM AV/AMSI: 4 custom actions me poshte (BackupAgentConfigBeforeLegacyRemove,
         CleanupLegacyEndpointInstallerRegistry, RestoreAgentConfigAfterLegacyRemove,
         RestoreAgentConfigFromLegacyBackup) mbeten me PowerShell ME QELLIM: ekzekutohen
         vetem gjate upgrade nga produktet antike v1.0.4 (Execute=immediate — para se
         techi-agent.exe i ri te jete instaluar, keshtu s'mund t'i kryeje ai). Ne klientet
         me AV strikt qe bllokon PS, efekti maksimal i deshtimit eshte qe migrimit 1.0.4
         i humbet device_id (pajisja ri-enrollohet si e re) — i pranueshem per nje rruge
         praktikisht te vdekur. Gjithe rruga normale e instalimit eshte script-free. -->
    <CustomAction Id="BackupAgentConfigBeforeLegacyRemove"
                  Directory="TECHIDATADIR"
                  ExeCommand="powershell.exe -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
                  Execute="immediate"
                  Return="ignore"/>
    <CustomAction Id="RemoveLegacyEndpoint104A"
                  Directory="SystemFolder"
                  ExeCommand="msiexec.exe /x [LEGACY_TECHI_ENDPOINT_104_A] /qn /norestart /l*v &quot;C:\Windows\Temp\techi-remove-legacy-104A.log&quot;"
                  Execute="immediate"
                  Return="ignore"/>
    <CustomAction Id="RemoveLegacyEndpoint104B"
                  Directory="SystemFolder"
                  ExeCommand="msiexec.exe /x [LEGACY_TECHI_ENDPOINT_104_B] /qn /norestart /l*v &quot;C:\Windows\Temp\techi-remove-legacy-104B.log&quot;"
                  Execute="immediate"
                  Return="ignore"/>
    <CustomAction Id="RemoveLegacyEndpoint104C"
                  Directory="SystemFolder"
                  ExeCommand="msiexec.exe /x [LEGACY_TECHI_ENDPOINT_104_C] /qn /norestart /l*v &quot;C:\Windows\Temp\techi-remove-legacy-104C.log&quot;"
                  Execute="immediate"
                  Return="ignore"/>
    <CustomAction Id="CleanupLegacyEndpointInstallerRegistry"
                  Directory="SystemFolder"
                  ExeCommand="powershell.exe -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $$keys=@('3EE5B9A51FBA63047BE88423E1B84525','7B8654310BCB143439B32CD47AD8FEE6','B7684513B0BC4143933BC24DA78DEF6E'); foreach ($$k in $$keys) { Remove-Item -Recurse -Force ('HKLM:\SOFTWARE\Classes\Installer\Products\'+$$k) -ErrorAction SilentlyContinue; Get-ChildItem 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Installer\UserData' -ErrorAction SilentlyContinue | ForEach-Object { Remove-Item -Recurse -Force ($$_.PSPath+'\Products\'+$$k) -ErrorAction SilentlyContinue } }; Remove-Item -Recurse -Force 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{134568B7-BCB0-4341-933B-C24DA78DEF6E}' -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{5A9B5EE3-ABF1-4036-B78E-48321E8B5452}' -ErrorAction SilentlyContinue"
                  Execute="immediate"
                  Return="ignore"/>
    <CustomAction Id="RestoreAgentConfigAfterLegacyRemove"
                  Directory="TECHIDATADIR"
                  ExeCommand="powershell.exe -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- CleanupProgramData: fshin C:\ProgramData\TECHI\ vetëm gjatë uninstall të plotë -->
    <CustomAction Id="RestoreAgentConfigFromLegacyBackup"
                  Directory="TECHIDATADIR"
                  ExeCommand="powershell.exe -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <CustomAction Id="CleanupProgramData"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /d /c del /f /q &quot;C:\Users\Public\Desktop\TECHI Remote Support.lnk&quot; &amp; rd /s /q &quot;C:\ProgramData\TECHI&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- KillTechiRS: vret proceset para fshirjes (uninstall) ose para InstallFiles
         (fresh install/upgrade — shih KillTechiRSBeforeInstall). Mbyll te dy emrat e
         mundshem: "TECHI Remote Support.exe" (branded) dhe "rustdesk.exe" (emri qe
         perdor installer-i real i vjeter, Inno Setup, ende ne flote). Pa kete, InstallFiles
         deshtonte te mbishkruante librustdesk.dll/flutter_windows.dll/data\* sepse RS
         eshte gjithmone ne xhirim — kjo dyshohet te jete shkaku i PC-ve qe mbeten offline
         pas dështimit te upgrade 2.0.0 -> 2.1.0 (deshtimi i InstallFiles mund te rrezoje
         e gjithe transaksioni MSI, perfshire upgrade-in e vete agent-it). -->
    <CustomAction Id="KillTechiRS"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /d /c taskkill /F /IM &quot;TECHI Remote Support.exe&quot; &amp; taskkill /F /IM rustdesk.exe"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- KillTechiRSBeforeInstall: njesoj si KillTechiRS, por para InstallFiles — mbulon
         fresh install (no-op, asnje proces s'ekziston) dhe upgrade (kritike, shih komenti
         siper). Dy CustomAction te ndara sepse i njejti Id s'mund te skedulohet dy here.
         "sc delete" e service-it "TECHI Remote Support" eshte gjithashtu e qellimshme: agent-i
         (rustdesk_manage.go: ensureRustDeskService) e rikrijon vete ne heartbeat-in e pare pas
         instalimit, me binPath-in dhe argumentet aktuale; duke e fshire pare, evitojme nje
         "sc create" me binPath te vjeter/gabuar te mbijetoje nje upgrade qe ndryshon shtegun. -->
    <CustomAction Id="KillTechiRSBeforeInstall"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /d /c taskkill /F /IM &quot;TECHI Remote Support.exe&quot; &amp; taskkill /F /IM rustdesk.exe &amp; sc delete &quot;TECHI Remote Support&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- RemoveRustDeskTrayArtifacts: pastrim i plote ne uninstall te plote; heq Scheduled
         Task-in "TECHI Remote Support Tray" (ikona shoqeruese) DHE service-in "TECHI Remote
         Support" (daemon-in real, krijuar ne runtime nga agent-i, jo nga kjo MSI; shih
         komenti i REMOTESUPPORTFOLDER me siper). -->
    <CustomAction Id="RemoveRustDeskTrayArtifacts"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /d /c schtasks /Delete /TN &quot;TECHI Remote Support Tray&quot; /F &amp; sc delete &quot;TECHI Remote Support&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- CreateRustDeskTrayTask: regjistron Scheduled Task "At Logon" qe nis RS me argumentin
         tray ne sesionin e perdoruesit interaktiv; ikona shoqeruese, JO daemon-i. Daemon-i real
         eshte Windows Service "TECHI Remote Support" (argumenti service), krijuar ne runtime nga
         agent-i (rustdesk_manage.go: ensureRustDeskService), jo nga kjo MSI. schtasks /run nga
         agent-i (rustdeskTrayTaskName) e rinis kete task po te mbyllet aksidentalisht.
         Ekzekutohet nga vete techi-agent.exe (rs-tray-task, kod natif Go, bootstrap_windows.go):
         shkruan XML-in e task-ut (grupi Users sipas SID S-1-5-32-545, ExecutionTimeLimit PT0S =
         pa limit kohor — default-i 72h do te mbyllte RS ne PC qe rrine ndezur gjate; schtasks CLI
         s'e shpreh dot, prandaj XML) dhe e regjistron me schtasks /Create /XML, pastaj /Run
         njehere per sesionin aktual (ne /quiet pa user te kyqur /Run s'ben asgje, pa dem).
         Pa PowerShell — AV/AMSI strikte (Symantec, CybeeAI) s'ka cfare te bllokoje; cdo hap
         logohet ne C:\ProgramData\TechiAgent\deploy.log me [rs-tray-task]. -->
    <CustomAction Id="CreateRustDeskTrayTask"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[INSTALLFOLDER]techi-agent.exe&quot; rs-tray-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- EpCustomActDll nga v1.0.4 — shkruan TOML konfigurim për TECHI Remote Support -->
    <Binary Id="EpCustomActDll" SourceFile="EpCustomActDll.dll"/>

    <!-- WriteTechiConfigs: shkruan TOML config (server/relay/key) për RS -->
    <CustomAction Id="WriteTechiConfigs.SetParam"
                  Property="WriteTechiConfigs"
                  Value="[REMOTE_SERVER]|[REMOTE_RELAY]|[REMOTE_KEY]|[API_URL]|[AppDataFolder]"/>
    <CustomAction Id="WriteTechiConfigs"
                  BinaryRef="EpCustomActDll"
                  DllEntry="WriteTechiConfigs"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- ApplyTechiRemoteSupportConfigFinal: aplikon konfigurimet finale të RS -->
    <CustomAction Id="ApplyTechiRemoteSupportConfigFinal.SetParam"
                  Property="ApplyTechiRemoteSupportConfigFinal"
                  Value="[REMOTE_SERVER]|[REMOTE_RELAY]|[REMOTE_KEY]|[API_URL]|[AppDataFolder]"/>
    <CustomAction Id="ApplyTechiRemoteSupportConfigFinal"
                  BinaryRef="EpCustomActDll"
                  DllEntry="ApplyTechiRemoteSupportConfigFinal"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- ===== SEKUENCA EKZEKUTIMI ===== -->
    <InstallExecuteSequence>
      <!-- Abort PARA InstallInitialize: kërkon token për fresh install OSE reinstall të pastër.
           (NOT Installed) = instalim i parë; (Installed AND REINSTALL) = msiexec REINSTALL=ALL.
           Skip-ohet gjatë upgrade të vërtetë (WIX_UPGRADE_DETECTED/UPGRADINGPRODUCTCODE). -->
      <Custom Action="AbortNoToken" Before="InstallInitialize" Condition="NOT ENROLLMENT_TOKEN AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND (NOT Installed OR (Installed AND REINSTALL))"/>
      <Custom Action="BackupAgentConfigBeforeLegacyRemove" After="CostFinalize" Condition="NOT REMOVE"/>
      <Custom Action="RemoveLegacyEndpoint104A" After="BackupAgentConfigBeforeLegacyRemove" Condition="NOT REMOVE"/>
      <Custom Action="RemoveLegacyEndpoint104B" After="RemoveLegacyEndpoint104A" Condition="NOT REMOVE"/>
      <Custom Action="RemoveLegacyEndpoint104C" After="RemoveLegacyEndpoint104B" Condition="NOT REMOVE"/>
      <Custom Action="CleanupLegacyEndpointInstallerRegistry" After="RemoveLegacyEndpoint104C" Condition="NOT REMOVE"/>
      <!-- KillTechiRSBeforeInstall: PARA InstallFiles, jo vetem PARA RemoveFiles te uninstall —
           file-at (librustdesk.dll, flutter_windows.dll, data\*) s'mund te mbishkruhen nese
           RS (e instaluar me herret nga Inno ose nga nje MSI i meparshem) eshte ne xhirim. -->
      <Custom Action="KillTechiRSBeforeInstall" Before="InstallFiles" Condition="NOT REMOVE"/>
      <!-- Install (fresh + upgrade): NOT REMOVE siguron ekzekutim gjatë çdo install, jo gjatë uninstall.
           WriteAgentConfig: PS script-i brenda kontrollon vetë nëse config ekziston (idempotent).
           SetServiceRecovery: duhet gjithmonë pas upgrade — v1.0.4 nuk e kishte vendosur.
           WriteTechiConfigs/Apply: rifresko RS TOML config pas çdo upgrade. -->
      <Custom Action="WriteAgentConfig"   After="InstallServices"    Condition="NOT REMOVE"/>
      <Custom Action="RestoreAgentConfigFromLegacyBackup" After="WriteAgentConfig" Condition="NOT REMOVE"/>
      <Custom Action="LockdownTechiDataDir" After="RestoreAgentConfigFromLegacyBackup" Condition="NOT REMOVE"/>
      <!-- EnsureServiceCreated: rrjet sigurie PARA SetServiceRecovery — nëse InstallServices
           nuk e krijoi service-in (race-condition SCM me DeleteServices të produktit të vjetër),
           e rikrijon këtu, kështu që SetServiceRecovery i aplikohet gjithsesi më pas. -->
      <Custom Action="EnsureServiceCreated" After="StartServices"    Condition="NOT REMOVE"/>
      <Custom Action="SetServiceRecovery" After="EnsureServiceCreated" Condition="NOT REMOVE"/>
      <!-- WriteTechiConfigs: shkruan TOML config për RS pas instalimit të skedarëve -->
      <Custom Action="WriteTechiConfigs.SetParam"               After="WriteAgentConfig"                   Condition="NOT REMOVE"/>
      <Custom Action="WriteTechiConfigs"                        After="WriteTechiConfigs.SetParam"          Condition="NOT REMOVE"/>
      <Custom Action="ApplyTechiRemoteSupportConfigFinal.SetParam" After="WriteTechiConfigs"               Condition="NOT REMOVE"/>
      <Custom Action="ApplyTechiRemoteSupportConfigFinal"       After="ApplyTechiRemoteSupportConfigFinal.SetParam" Condition="NOT REMOVE"/>
      <!-- CreateRustDeskTrayTask: pasi RS eshte instaluar dhe konfiguruar, regjistro
           Scheduled Task-in "At Logon" qe e nis ne sesionin e perdoruesit. -->
      <Custom Action="CreateRustDeskTrayTask" After="ApplyTechiRemoteSupportConfigFinal" Condition="NOT REMOVE"/>
      <!-- Uninstall -->
      <Custom Action="KillTechiRS"                Before="RemoveFiles"     Condition="REMOVE~=&quot;ALL&quot;"/>
      <Custom Action="RemoveRustDeskTrayArtifacts" After="KillTechiRS"      Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="CleanupProgramData"         After="RemoveRustDeskTrayArtifacts" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    </InstallExecuteSequence>

  </Package>
</Wix>
