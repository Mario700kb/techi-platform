<?xml version="1.0" encoding="UTF-8"?>
<!--
  TECHI Agent-only MSI

  This package owns only the TECHI Agent binary, service registration, and
  Agent registry metadata. It deliberately does not install, stop, configure,
  repair, or restart TECHI Remote Support. Deployment orchestration writes
  bootstrap config before install/repair and starts/validates the service only
  after msiexec has exited.
-->
<?ifndef Version?>
<?define Version="0.0.0.0"?>
<?endif?>
<?ifndef BuildCommit?>
<?define BuildCommit="dev"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="TECHI Agent"
           Version="$(var.Version)"
           Manufacturer="TECHI Solutions SH.P.K."
           UpgradeCode="E6AD0A88-5F26-5665-9B1F-70B8C5EE8363"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of TECHI Agent is already installed."
                  Schedule="afterInstallExecute"/>
    <MediaTemplate EmbedCab="yes"/>

    <Property Id="ARPCOMMENTS" Value="TECHI Platform endpoint management agent"/>
    <Icon Id="TechiIcon" SourceFile="..\TECHI-branding-assets\techi-icon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="TechiIcon"/>
    <Binary Id="TechiIconBin" SourceFile="..\TECHI-branding-assets\techi-icon.ico"/>
    <Binary Id="BannerBmp" SourceFile="banner.bmp"/>
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="banner.bmp"/>
    <Property Id="ENROLLMENT_TOKEN" Secure="yes" Hidden="yes"/>
    <Property Id="API_URL" Value="https://api-rdp.techi.com.al" Secure="yes"/>

    <!-- Abort (Type 19): token is required only for fresh manual/quiet installs.
         Existing healthy Agents are upgraded by UI/self-update, not by this MSI. -->
    <CustomAction Id="AbortNoToken"
                  Error="Enrollment token is required for first installation.&#13;&#10;GPO: use techi-deploy.cmd so config is written before the Agent MSI runs."/>

    <ui:WixUI Id="WixUI_Common"/>

    <UI>
      <Dialog Id="EnrollmentTokenDlg" Width="370" Height="185" Title="[ProductName] — Setup">
        <Control Id="DialogIcon" Type="Icon" X="15" Y="8" Width="32" Height="32"
                 ToolTip="TECHI" FixedSize="yes" IconSize="32" Text="TechiIconBin"/>

        <Control Id="Title" Type="Text" X="50" Y="10" Width="300" Height="15"
                 Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}TECHI Agent — Enrollment"/>
        </Control>
        <Control Id="Subtitle" Type="Text" X="50" Y="26" Width="300" Height="18"
                 Transparent="yes" NoPrefix="yes">
          <Text Value="Enter the enrollment token to register this device with TECHI platform."/>
        </Control>

        <Control Id="Sep1" Type="Line" X="0" Y="48" Width="370" Height="0"/>

        <Control Id="TokenLabel" Type="Text" X="20" Y="58" Width="330" Height="12"
                 NoPrefix="yes">
          <Text Value="&amp;Enrollment Token:"/>
        </Control>
        <Control Id="TokenEdit" Type="Edit" X="20" Y="73" Width="330" Height="20"
                 Property="ENROLLMENT_TOKEN" Text="{256}" TabSkip="no"/>

        <Control Id="Sep2" Type="Line" X="0" Y="149" Width="370" Height="0"/>

        <Control Id="Install" Type="PushButton" X="178" Y="158" Width="80" Height="17"
                 Default="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return"
                   Condition="ENROLLMENT_TOKEN &lt;&gt; &quot;&quot;"/>
          <Publish Event="SpawnDialog" Value="TokenRequiredDlg"
                   Condition="ENROLLMENT_TOKEN = &quot;&quot;"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="270" Y="158" Width="80" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1"/>
        </Control>
      </Dialog>

      <Dialog Id="TokenRequiredDlg" Width="260" Height="85" Title="TECHI Agent" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="40" NoPrefix="yes">
          <Text Value="Enrollment token is required for first installation.&#13;&#10;&#13;&#10;Use the generated deployment script for GPO/NETLOGON installs."/>
        </Control>
        <Control Id="OK" Type="PushButton" X="102" Y="58" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" Condition="1"/>
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="EnrollmentTokenDlg" Before="ExecuteAction" Condition="NOT Installed"/>
      </InstallUISequence>
    </UI>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="TechiAgent"/>
      <Directory Id="TECHIDATADIR" Name="TECHI"/>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="TECHI Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
    </Feature>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExe" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="TechiAgentExe"
              Source="$(var.SourceDir)\techi-agent.exe"
              Name="techi-agent.exe"
              KeyPath="yes"/>
        <ServiceInstall Id="TechiAgentService"
                        Name="TechiAgent"
                        DisplayName="TECHI Agent"
                        Description="TECHI Platform endpoint monitoring and management agent"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="ignore"
                        Account="LocalSystem"/>
        <ServiceControl Id="StopRemoveTechiAgent"
                        Name="TechiAgent"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes"/>
      </Component>

      <Component Id="AgentDataDir" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891"
                 Directory="TECHIDATADIR">
        <CreateFolder/>
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\TECHI\Agent"
                       Name="DataDir"
                       Type="string"
                       Value="[TECHIDATADIR]"
                       KeyPath="yes"/>
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\TECHI\Agent"
                       Name="BuildCommit"
                       Type="string"
                       Value="$(var.BuildCommit)"/>
      </Component>
    </ComponentGroup>

    <InstallExecuteSequence>
      <Custom Action="AbortNoToken" Before="InstallInitialize"
              Condition="NOT ENROLLMENT_TOKEN AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND (NOT Installed OR (Installed AND REINSTALL))"/>
    </InstallExecuteSequence>

  </Package>
</Wix>
