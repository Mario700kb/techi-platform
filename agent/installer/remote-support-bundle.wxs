<?xml version="1.0" encoding="UTF-8"?>
<!--
  TECHI Remote Support standalone EXE bootstrapper.

  This EXE wraps the standalone Remote Support MSI without adding, removing, or
  changing the installed payload. Runtime ownership remains in remote-support.wxs.
-->
<?ifndef Version?>
<?define Version="1.4.6.0"?>
<?endif?>
<?ifndef MsiPath?>
<?define MsiPath="TECHI-Remote-Support-1.4.6.msi"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="TECHI Remote Support"
          Version="$(var.Version)"
          Manufacturer="TECHI Solutions SH.P.K."
          UpgradeCode="38A62018-0F15-4A58-BD5A-944B9A336F47"
          IconSourceFile="..\TECHI-branding-assets\techi-icon.ico">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://techi.com.al/"/>
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)"
                  Compressed="yes"
                  DisplayInternalUI="yes"/>
    </Chain>
  </Bundle>
</Wix>
