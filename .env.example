# ============================================================
# TECHI Platform — Environment Template
# Copy to .env and fill in every value marked REQUIRED.
# NEVER commit .env to version control.
# ============================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Production: PostgreSQL (container service name "postgres" is the hostname)
DATABASE_URL=postgresql://techi:techi@postgres:5432/techi

# Postgres container credentials (must match DATABASE_URL above)
POSTGRES_USER=techi
POSTGRES_PASSWORD=techi
POSTGRES_DB=techi

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_secure_random_value

# Runtime environment: "production" enforces JWT_SECRET, disables random fallback.
ENVIRONMENT=production

# Bootstrap owner account — set before first startup.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_EMAIL=owner@localhost
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_set_a_strong_password

# ─── CORS ────────────────────────────────────────────────────────────────────
# List the exact origins the browser frontend is served from (comma-separated).
# Example: https://techi.yourdomain.com,https://www.yourdomain.com
BACKEND_CORS_ORIGINS=https://techi.yourdomain.com

# Development/LAN only — allows ALL origins. NEVER enable in production.
BACKEND_CORS_ALLOW_ALL=false

# ─── Ports ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432

# ─── Frontend API / WebSocket URLs (baked into build at image build time) ────
# Set these to the public-facing URLs that browsers use to reach the backend.
# Leave blank to auto-detect from window.location (works when frontend and
# backend share the same hostname and the backend is at :8000).
#
# Example (separate subdomains via Nginx Proxy Manager):
#   VITE_API_BASE_URL=https://api.yourdomain.com
#   VITE_WS_BASE_URL=wss://api.yourdomain.com
#
# Example (single domain, nginx path-routing):
#   VITE_API_BASE_URL=https://techi.yourdomain.com
#   VITE_WS_BASE_URL=wss://techi.yourdomain.com
#
# When blank, the frontend uses window.location.hostname:8000 as the base.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# ─── Agent Package Storage ───────────────────────────────────────────────────
# Path inside the backend container where agent packages are stored.
# Must match the Docker volume mount target in docker-compose.yml.
AGENT_PACKAGE_STORAGE_DIR=agent_packages

# ─── Device Reconciliation ───────────────────────────────────────────────────
HEARTBEAT_TIMEOUT_SECONDS=300
RECONCILIATION_INTERVAL_SECONDS=30

# ─── Default Deployment Token ────────────────────────────────────────────────
DEFAULT_DEPLOYMENT_TOKEN_ENABLED=true
DEFAULT_DEPLOYMENT_TOKEN_MAX_USES=500
DEFAULT_DEPLOYMENT_TOKEN_EXPIRES_DAYS=0

# ─── RustDesk Resolver (optional) ───────────────────────────────────────────
# Enable only if you have a RustDesk server and want ID lookups.
RUSTDESK_RESOLVER_ENABLED=false
RUSTDESK_SERVER_DB_PATH=

# ─── Trusted Domain Auto-Enrollment (optional) ──────────────────────────────
TRUSTED_DOMAIN_AUTO_ENROLLMENT=false
TRUSTED_DOMAIN_ALLOWLIST=
